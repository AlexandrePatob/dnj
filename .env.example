# URL pública da API externa, incluindo o prefixo /v2. O navegador chama a API
# diretamente com Authorization: Bearer; não há proxy Next nem cookies de sessão.
NEXT_PUBLIC_API_URL=https://ttwkfudhvvhuhp5yvsoydxggum0ictpg.lambda-url.sa-east-1.on.aws/v2
# Desenvolvimento local contra a API em localhost:
# NEXT_PUBLIC_API_URL=http://localhost:8081/v2
NEXT_PUBLIC_GOOGLE_CLIENT_ID=350641083642-r0kuku5b4oobbemb02gkjkjvkb58qmbs.apps.googleusercontent.com
# Upstream usado somente pelas rotas Next que exigem segredo no servidor (Push).
DNJ_V2_UPSTREAM_URL=https://ttwkfudhvvhuhp5yvsoydxggum0ictpg.lambda-url.sa-east-1.on.aws/v2

# Firebase web client configuration for the pastoral Firestore module.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Push Web: a chave privada permanece somente no backend da API externa.
VAPID_PUBLIC_KEY=

# Não adicionar variáveis SUPABASE_* aqui. Supabase não faz parte da arquitetura atual.
