rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The pastoral queue intentionally uses direct Firestore access. The DNJ
    // app is the product boundary; no identity data or pastoral content is
    // stored here. Management authorization remains at the DNJ surface.
    match /pastoral_queue/{document=**} {
      allow read, write: if true;
    }

    // Keep this Firebase project isolated from unrelated documents.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
