rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy DNJ queue collections intentionally use direct Firestore access.
    match /config/{document=**} {
      allow read, write: if true;
    }
    match /queue/{document=**} {
      allow read, write: if true;
    }
    match /calledPeople/{document=**} {
      allow read, write: if true;
    }

    // Keep this Firebase project isolated from unrelated documents.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
